\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {Cross-visit correlation structure (amplified residual scale).} Same layout as the main-text figure, but with the bottom-row residual panels plotted on a $\pm 0.5$ color scale (vs.\ $\pm 1.0$ in the main text) to reveal fine structure in the correlation differences. Frobenius norms of each residual matrix are shown in the panel titles. The MVN$-$Real residual is systematically smooth (reflecting regularization-induced shrinkage), while the SA$-$Real residual is noisier but unbiased.}}{1}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{sfig:cross-visit-corr-supp}{{S1}{1}{\textbf {Cross-visit correlation structure (amplified residual scale).} Same layout as the main-text figure, but with the bottom-row residual panels plotted on a $\pm 0.5$ color scale (vs.\ $\pm 1.0$ in the main text) to reveal fine structure in the correlation differences. Frobenius norms of each residual matrix are shown in the panel titles. The MVN$-$Real residual is systematically smooth (reflecting regularization-induced shrinkage), while the SA$-$Real residual is noisier but unbiased}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Within-visit correlation heatmaps.} Pearson correlation matrices for real and SA-generated synthetic patients within each visit (72 features per visit). SA preserves the within-visit correlation structure across all three visits.}}{2}{figure.caption.3}\protected@file@percent }
\newlabel{sfig:corr-heatmaps}{{S2}{2}{\textbf {Within-visit correlation heatmaps.} Pearson correlation matrices for real and SA-generated synthetic patients within each visit (72 features per visit). SA preserves the within-visit correlation structure across all three visits}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Covariance eigenvalue spectrum.} Log-scale eigenvalues of the $216 \times 216$ sample covariance for Real ($K{=}23$, rank~22), SA ($N{=}100$, rank~18), and MVN ($N{=}100$) populations. Dashed vertical lines mark the SA PCA truncation point (component~18) and the data rank limit (component~22, $K{-}1$). SA's spectrum drops cleanly at the PCA truncation, matching the low-rank data structure. MVN's Ledoit--Wolf regularization inflates eigenvalues beyond component~22 (green shaded region), introducing spurious variance in 194 dimensions where the data contain none. This spurious variance is the structural origin of the increased MVN dispersion visible in the PCA projections (main-text Fig.~4).}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{sfig:eigenvalue-spectrum}{{S3}{3}{\textbf {Covariance eigenvalue spectrum.} Log-scale eigenvalues of the $216 \times 216$ sample covariance for Real ($K{=}23$, rank~22), SA ($N{=}100$, rank~18), and MVN ($N{=}100$) populations. Dashed vertical lines mark the SA PCA truncation point (component~18) and the data rank limit (component~22, $K{-}1$). SA's spectrum drops cleanly at the PCA truncation, matching the low-rank data structure. MVN's Ledoit--Wolf regularization inflates eigenvalues beyond component~22 (green shaded region), introducing spurious variance in 194 dimensions where the data contain none. This spurious variance is the structural origin of the increased MVN dispersion visible in the PCA projections (main-text Fig.~4)}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces \textbf  {SA vs.\ MVN quantitative comparison.} Per-visit comparison of mean relative error, standard deviation relative error, KS statistic, and correlation MAE between SA and MVN generation methods. Both methods perform comparably on marginal statistics (Level~1), but diverge on structural measures (correlation MAE).}}{3}{figure.caption.5}\protected@file@percent }
\newlabel{sfig:metrics-bar}{{S4}{3}{\textbf {SA vs.\ MVN quantitative comparison.} Per-visit comparison of mean relative error, standard deviation relative error, KS statistic, and correlation MAE between SA and MVN generation methods. Both methods perform comparably on marginal statistics (Level~1), but diverge on structural measures (correlation MAE)}{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces \textbf  {Inverse temperature sensitivity analysis.} SA generation quality as a function of $\beta / \beta ^*$, where $\beta ^* \approx 2.94$ was identified via entropy inflection in the 18-dimensional PCA space ($K{=}23$ stored patterns). The theoretical prediction $\beta ^* = \sqrt  {d} = \sqrt  {18} \approx 4.24$ is close to the empirical value. Operating at $\beta = \beta ^*$ (bold row) balances generation novelty against fidelity: lower $\beta $ produces more diverse but less faithful samples; higher $\beta $ produces more faithful but less novel samples (approaching memorization). MRE = median relative error of per-feature means; Corr MAE = mean absolute error of the correlation matrix; Novelty = $1 - \max _k \cos (\hat  {\xi }, \hat  {m}_k)$.}}{4}{table.caption.7}\protected@file@percent }
\newlabel{stab:beta-sweep}{{S1}{4}{\textbf {Inverse temperature sensitivity analysis.} SA generation quality as a function of $\beta / \beta ^*$, where $\beta ^* \approx 2.94$ was identified via entropy inflection in the 18-dimensional PCA space ($K{=}23$ stored patterns). The theoretical prediction $\beta ^* = \sqrt {d} = \sqrt {18} \approx 4.24$ is close to the empirical value. Operating at $\beta = \beta ^*$ (bold row) balances generation novelty against fidelity: lower $\beta $ produces more diverse but less faithful samples; higher $\beta $ produces more faithful but less novel samples (approaching memorization). MRE = median relative error of per-feature means; Corr MAE = mean absolute error of the correlation matrix; Novelty = $1 - \max _k \cos (\hat {\xi }, \hat {m}_k)$}{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces \textbf  {Multiplicity weighting parameters for conditional generation.} For each clinical subgroup, the multiplicity ratio $\rho $ was computed to achieve a target effective fraction $f_{\text  {target}} = 0.80$ of softmax attention on the designated patterns. $K_{\text  {eff}}$ is the participation ratio, quantifying the effective number of patterns contributing to generation. PCOS required the highest $\rho $ (26.7) due to having only 3 stored patterns, reducing $K_{\text  {eff}}$ to 4.6 and explaining the larger MREs observed for this subgroup at Level~3.}}{4}{table.caption.8}\protected@file@percent }
\newlabel{stab:multiplicity}{{S2}{4}{\textbf {Multiplicity weighting parameters for conditional generation.} For each clinical subgroup, the multiplicity ratio $\rho $ was computed to achieve a target effective fraction $f_{\text {target}} = 0.80$ of softmax attention on the designated patterns. $K_{\text {eff}}$ is the participation ratio, quantifying the effective number of patterns contributing to generation. PCOS required the highest $\rho $ (26.7) due to having only 3 stored patterns, reducing $K_{\text {eff}}$ to 4.6 and explaining the larger MREs observed for this subgroup at Level~3}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces \textbf  {PCA variance threshold sensitivity analysis.} SA generation quality as a function of the PCA variance retention threshold ($d_{\text  {PCA}}$ ranges from 13 to 21 dimensions). The 95\% threshold used in the main text (bold) is not a critical choice: median MRE is stable at 1.2--1.8\% across all thresholds, and correlation MAE varies modestly (0.116--0.148). Higher thresholds retain more variance but reduce the $K/d$ ratio, approaching the regime where SA has fewer stored patterns than dimensions. Novelty increases with $d_{\text  {PCA}}$ because more dimensions provide more room for interpolation.}}{4}{table.caption.9}\protected@file@percent }
\newlabel{stab:pca-sensitivity}{{S3}{4}{\textbf {PCA variance threshold sensitivity analysis.} SA generation quality as a function of the PCA variance retention threshold ($d_{\text {PCA}}$ ranges from 13 to 21 dimensions). The 95\% threshold used in the main text (bold) is not a critical choice: median MRE is stable at 1.2--1.8\% across all thresholds, and correlation MAE varies modestly (0.116--0.148). Higher thresholds retain more variance but reduce the $K/d$ ratio, approaching the regime where SA has fewer stored patterns than dimensions. Novelty increases with $d_{\text {PCA}}$ because more dimensions provide more room for interpolation}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces \textbf  {Comparison with deep generative baselines.} CTGAN and TVAE (from the Synthetic Data Vault library) were trained on the same 90 per-visit records (23 patients $\times $ 3 visits, 72 features) at three epoch counts. SA and MVN results from the main text are shown for reference. CTGAN fails catastrophically at this sample size (median MRE $\approx $~19\%, $10\times $ worse than SA), consistent with known GAN mode collapse behavior on small datasets. TVAE achieves comparable marginal fidelity to SA at high epoch counts (MRE~1.8\% at 3,000 epochs) but operates on per-visit rows rather than concatenated longitudinal profiles, so it cannot capture cross-visit covariance structure and has no mechanism for conditional subgroup generation. Med KS = median two-sample KS statistic across all features; Corr MAE = mean absolute error of the within-visit correlation matrix.}}{5}{table.caption.10}\protected@file@percent }
\newlabel{stab:ctgan}{{S4}{5}{\textbf {Comparison with deep generative baselines.} CTGAN and TVAE (from the Synthetic Data Vault library) were trained on the same 90 per-visit records (23 patients $\times $ 3 visits, 72 features) at three epoch counts. SA and MVN results from the main text are shown for reference. CTGAN fails catastrophically at this sample size (median MRE $\approx $~19\%, $10\times $ worse than SA), consistent with known GAN mode collapse behavior on small datasets. TVAE achieves comparable marginal fidelity to SA at high epoch counts (MRE~1.8\% at 3,000 epochs) but operates on per-visit rows rather than concatenated longitudinal profiles, so it cannot capture cross-visit covariance structure and has no mechanism for conditional subgroup generation. Med KS = median two-sample KS statistic across all features; Corr MAE = mean absolute error of the within-visit correlation matrix}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces \textbf  {Summary of mean relative errors across all 72 features.} Per-visit distribution of MREs between real and SA-generated synthetic patient means. The full feature-by-feature table (72 features $\times $ 3 visits = 216 entries) is provided in the code repository as \texttt  {paper\_summary\_statistics.csv}.}}{5}{table.caption.11}\protected@file@percent }
\newlabel{stab:mre-summary}{{S5}{5}{\textbf {Summary of mean relative errors across all 72 features.} Per-visit distribution of MREs between real and SA-generated synthetic patient means. The full feature-by-feature table (72 features $\times $ 3 visits = 216 entries) is provided in the code repository as \texttt {paper\_summary\_statistics.csv}}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces \textbf  {SA generation hyperparameters.} All parameters used for synthetic patient generation. The same values were used for unconditioned and conditioned generation except where noted.}}{5}{table.caption.12}\protected@file@percent }
\newlabel{stab:hyperparams}{{S6}{5}{\textbf {SA generation hyperparameters.} All parameters used for synthetic patient generation. The same values were used for unconditioned and conditioned generation except where noted}{table.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S7}{\ignorespaces \textbf  {BZ2012 ODE model calibration.} Five rate constants were calibrated on Visit~1 real patients ($n{=}23$) using bounded Nelder--Mead optimization (Fminbox) in log-scale-factor space. The cost function was the mean normalized relative squared error across five TGA features (lagtime, peak, time-to-peak, maximum rate, ETP) under both TF-only and TF+TM conditions. Bounds: $\pm \log (100)$ (0.01$\times $ to 100$\times $ default). Convergence: $f_{\text  {tol}} = 10^{-6}$, 500 iterations.}}{6}{table.caption.13}\protected@file@percent }
\newlabel{stab:ode-calibration}{{S7}{6}{\textbf {BZ2012 ODE model calibration.} Five rate constants were calibrated on Visit~1 real patients ($n{=}23$) using bounded Nelder--Mead optimization (Fminbox) in log-scale-factor space. The cost function was the mean normalized relative squared error across five TGA features (lagtime, peak, time-to-peak, maximum rate, ETP) under both TF-only and TF+TM conditions. Bounds: $\pm \log (100)$ (0.01$\times $ to 100$\times $ default). Convergence: $f_{\text {tol}} = 10^{-6}$, 500 iterations}{table.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {Conditioned generation: PCA projection (pooled).} PCA projection of condition-specific synthetic cohorts generated by multiplicity-weighted SA. Large markers: real patients (blue = Healthy, $n{=}14$; orange = PCOS, $n{=}3$; red = PE, $n{=}5$). Small markers: synthetic patients ($N{=}100$ per condition). With only 3 PCOS and 5 PE patients, the subgroups do not form clearly separable clusters in the first two principal components, but the synthetic cohorts concentrate around their respective real counterparts.}}{6}{figure.caption.15}\protected@file@percent }
\newlabel{sfig:conditioned-pca}{{S5}{6}{\textbf {Conditioned generation: PCA projection (pooled).} PCA projection of condition-specific synthetic cohorts generated by multiplicity-weighted SA. Large markers: real patients (blue = Healthy, $n{=}14$; orange = PCOS, $n{=}3$; red = PE, $n{=}5$). Small markers: synthetic patients ($N{=}100$ per condition). With only 3 PCOS and 5 PE patients, the subgroups do not form clearly separable clusters in the first two principal components, but the synthetic cohorts concentrate around their respective real counterparts}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces \textbf  {Conditioned generation: PCA projection by visit.} Same as Supplementary Fig.~\ref {sfig:conditioned-pca} but separated by visit (V1, V2, V3). The condition-specific clustering patterns are maintained within each individual visit.}}{7}{figure.caption.16}\protected@file@percent }
\newlabel{sfig:conditioned-by-visit}{{S6}{7}{\textbf {Conditioned generation: PCA projection by visit.} Same as Supplementary Fig.~\ref {sfig:conditioned-pca} but separated by visit (V1, V2, V3). The condition-specific clustering patterns are maintained within each individual visit}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces \textbf  {Level~4: Mechanistic model predicted vs.\ measured TGA features (TF+TM condition).} Same layout as main-text Fig.~6. The model systematically underpredicts peak and maximum rate ($\approx 0.5\times $ measured) for both real and synthetic patients, reflecting overcorrection of the protein~C anticoagulant pathway. The shared bias indicates that synthetic patients are processed identically to real patients by the mechanistic model.}}{7}{figure.caption.17}\protected@file@percent }
\newlabel{sfig:mechanistic-tm}{{S7}{7}{\textbf {Level~4: Mechanistic model predicted vs.\ measured TGA features (TF+TM condition).} Same layout as main-text Fig.~6. The model systematically underpredicts peak and maximum rate ($\approx 0.5\times $ measured) for both real and synthetic patients, reflecting overcorrection of the protein~C anticoagulant pathway. The shared bias indicates that synthetic patients are processed identically to real patients by the mechanistic model}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces \textbf  {Level~4: Predicted/measured ratio distributions (TF+TM condition).} Same layout as main-text Fig.~7. Despite the systematic bias in peak and maximum rate, the ratio distributions for real and synthetic patients overlap substantially (88--91\% cloud overlap).}}{7}{figure.caption.18}\protected@file@percent }
\newlabel{sfig:ratios-tm}{{S8}{7}{\textbf {Level~4: Predicted/measured ratio distributions (TF+TM condition).} Same layout as main-text Fig.~7. Despite the systematic bias in peak and maximum rate, the ratio distributions for real and synthetic patients overlap substantially (88--91\% cloud overlap)}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S9}{\ignorespaces \textbf  {Level~4: Cross-visit calibration generalization (TF-only).} Boxplots of the predicted/measured ratio by visit for real patients. The model was calibrated on Visit~1 (``train'') only. Ratios near 1.0 at Visits~2 and~3 indicate that the population-level calibration generalizes across pregnancy timepoints.}}{8}{figure.caption.19}\protected@file@percent }
\newlabel{sfig:generalization}{{S9}{8}{\textbf {Level~4: Cross-visit calibration generalization (TF-only).} Boxplots of the predicted/measured ratio by visit for real patients. The model was calibrated on Visit~1 (``train'') only. Ratios near 1.0 at Visits~2 and~3 indicate that the population-level calibration generalizes across pregnancy timepoints}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S10}{\ignorespaces \textbf  {Level~4: Spearman rank correlations (TF-only).} Mean Spearman $\rho $ between predicted and measured TGA features, averaged across visits, for real and synthetic patients. ETP is the best-predicted feature ($\rho \approx 0.6$--$0.8$). Weak rank correlations for other features are expected given the population-level (not patient-level) calibration.}}{8}{figure.caption.20}\protected@file@percent }
\newlabel{sfig:rankcorr}{{S10}{8}{\textbf {Level~4: Spearman rank correlations (TF-only).} Mean Spearman $\rho $ between predicted and measured TGA features, averaged across visits, for real and synthetic patients. ETP is the best-predicted feature ($\rho \approx 0.6$--$0.8$). Weak rank correlations for other features are expected given the population-level (not patient-level) calibration}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S11}{\ignorespaces \textbf  {Level~4: Cross-visit calibration generalization (TF+TM).} Same layout as Supplementary Fig.~\ref {sfig:generalization}. The TF+TM calibration does not generalize as well as TF-only, particularly for peak and maximum rate, due to overcorrection of the protein~C pathway.}}{8}{figure.caption.21}\protected@file@percent }
\newlabel{sfig:generalization-tm}{{S11}{8}{\textbf {Level~4: Cross-visit calibration generalization (TF+TM).} Same layout as Supplementary Fig.~\ref {sfig:generalization}. The TF+TM calibration does not generalize as well as TF-only, particularly for peak and maximum rate, due to overcorrection of the protein~C pathway}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S12}{\ignorespaces \textbf  {Level~4: Spearman rank correlations (TF+TM).} Same layout as Supplementary Fig.~\ref {sfig:rankcorr}. Rank correlations under TF+TM are generally weaker than TF-only, consistent with the poorer calibration generalization under this condition.}}{9}{figure.caption.22}\protected@file@percent }
\newlabel{sfig:rankcorr-tm}{{S12}{9}{\textbf {Level~4: Spearman rank correlations (TF+TM).} Same layout as Supplementary Fig.~\ref {sfig:rankcorr}. Rank correlations under TF+TM are generally weaker than TF-only, consistent with the poorer calibration generalization under this condition}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S13}{\ignorespaces \textbf  {Factor~X vs.\ Maximum Clot Firmness (MCF) trajectory.} The characteristic pregnancy-driven shift in the Factor~X--MCF plane is preserved in SA-generated synthetic patients, demonstrating that biologically meaningful multivariate trajectories are captured by the generation pipeline.}}{9}{figure.caption.23}\protected@file@percent }
\newlabel{sfig:x-vs-mcf}{{S13}{9}{\textbf {Factor~X vs.\ Maximum Clot Firmness (MCF) trajectory.} The characteristic pregnancy-driven shift in the Factor~X--MCF plane is preserved in SA-generated synthetic patients, demonstrating that biologically meaningful multivariate trajectories are captured by the generation pipeline}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S14}{\ignorespaces \textbf  {Full longitudinal trajectories.} Individual patient trajectories (all 72 features) across three visits for both real and SA-generated synthetic patients, demonstrating coherent longitudinal patterns.}}{10}{figure.caption.24}\protected@file@percent }
\newlabel{sfig:full-trajectories}{{S14}{10}{\textbf {Full longitudinal trajectories.} Individual patient trajectories (all 72 features) across three visits for both real and SA-generated synthetic patients, demonstrating coherent longitudinal patterns}{figure.caption.24}{}}
