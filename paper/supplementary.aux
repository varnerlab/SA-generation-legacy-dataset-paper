\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {Within-visit correlation heatmaps.} Pearson correlation matrices for real and SA-generated synthetic patients within each visit (72 features per visit). SA preserves the within-visit correlation structure across all three visits.}}{1}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{sfig:corr-heatmaps}{{S1}{1}{\textbf {Within-visit correlation heatmaps.} Pearson correlation matrices for real and SA-generated synthetic patients within each visit (72 features per visit). SA preserves the within-visit correlation structure across all three visits}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {SA vs.\ MVN quantitative comparison.} Per-visit comparison of mean relative error, standard deviation relative error, KS statistic, and correlation MAE between SA and MVN generation methods. Both methods perform comparably on marginal statistics (Level~1), but diverge on structural measures (correlation MAE).}}{2}{figure.caption.3}\protected@file@percent }
\newlabel{sfig:metrics-bar}{{S2}{2}{\textbf {SA vs.\ MVN quantitative comparison.} Per-visit comparison of mean relative error, standard deviation relative error, KS statistic, and correlation MAE between SA and MVN generation methods. Both methods perform comparably on marginal statistics (Level~1), but diverge on structural measures (correlation MAE)}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Conditioned generation by visit.} PCA projections of condition-specific synthetic cohorts (Healthy, PCOS, PE) separated by visit (V1, V2, V3). The condition-specific clustering observed in the pooled projection (Fig.~5 in main text) is maintained within each individual visit.}}{2}{figure.caption.4}\protected@file@percent }
\newlabel{sfig:conditioned-by-visit}{{S3}{2}{\textbf {Conditioned generation by visit.} PCA projections of condition-specific synthetic cohorts (Healthy, PCOS, PE) separated by visit (V1, V2, V3). The condition-specific clustering observed in the pooled projection (Fig.~5 in main text) is maintained within each individual visit}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces \textbf  {Level~4: Mechanistic model predicted vs.\ measured TGA features (TF+TM condition).} Same layout as Fig.~6 in the main text. The model systematically underpredicts peak and maximum rate ($\approx 0.5\times $ measured) for both real and synthetic patients, reflecting overcorrection of the protein~C anticoagulant pathway. The shared bias indicates that synthetic patients are processed identically to real patients by the mechanistic model.}}{2}{figure.caption.5}\protected@file@percent }
\newlabel{sfig:mechanistic-tm}{{S4}{2}{\textbf {Level~4: Mechanistic model predicted vs.\ measured TGA features (TF+TM condition).} Same layout as Fig.~6 in the main text. The model systematically underpredicts peak and maximum rate ($\approx 0.5\times $ measured) for both real and synthetic patients, reflecting overcorrection of the protein~C anticoagulant pathway. The shared bias indicates that synthetic patients are processed identically to real patients by the mechanistic model}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {Level~4: Predicted/measured ratio distributions (TF+TM condition).} Same layout as Fig.~7 in the main text. Despite the systematic bias in peak and maximum rate, the ratio distributions for real and synthetic patients overlap substantially (88--91\% cloud overlap).}}{3}{figure.caption.6}\protected@file@percent }
\newlabel{sfig:ratios-tm}{{S5}{3}{\textbf {Level~4: Predicted/measured ratio distributions (TF+TM condition).} Same layout as Fig.~7 in the main text. Despite the systematic bias in peak and maximum rate, the ratio distributions for real and synthetic patients overlap substantially (88--91\% cloud overlap)}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces \textbf  {Level~4: Cross-visit calibration generalization (TF-only).} Boxplots of the predicted/measured ratio by visit for real patients. The model was calibrated on Visit~1 (``train'') only. Ratios near 1.0 at Visits~2 and~3 indicate that the population-level calibration generalizes across pregnancy timepoints.}}{3}{figure.caption.7}\protected@file@percent }
\newlabel{sfig:generalization}{{S6}{3}{\textbf {Level~4: Cross-visit calibration generalization (TF-only).} Boxplots of the predicted/measured ratio by visit for real patients. The model was calibrated on Visit~1 (``train'') only. Ratios near 1.0 at Visits~2 and~3 indicate that the population-level calibration generalizes across pregnancy timepoints}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces \textbf  {Level~4: Spearman rank correlations (TF-only).} Mean Spearman $\rho $ between predicted and measured TGA features, averaged across visits, for real and synthetic patients. ETP is the best-predicted feature ($\rho \approx 0.6$--$0.8$). Weak rank correlations for other features are expected given the population-level (not patient-level) calibration.}}{3}{figure.caption.8}\protected@file@percent }
\newlabel{sfig:rankcorr}{{S7}{3}{\textbf {Level~4: Spearman rank correlations (TF-only).} Mean Spearman $\rho $ between predicted and measured TGA features, averaged across visits, for real and synthetic patients. ETP is the best-predicted feature ($\rho \approx 0.6$--$0.8$). Weak rank correlations for other features are expected given the population-level (not patient-level) calibration}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces \textbf  {Level~4: Cross-visit calibration generalization (TF+TM).} Same layout as Supplementary Fig.~\ref {sfig:generalization}. The TF+TM calibration does not generalize as well as TF-only, particularly for peak and maximum rate, due to overcorrection of the protein~C pathway.}}{4}{figure.caption.9}\protected@file@percent }
\newlabel{sfig:generalization-tm}{{S8}{4}{\textbf {Level~4: Cross-visit calibration generalization (TF+TM).} Same layout as Supplementary Fig.~\ref {sfig:generalization}. The TF+TM calibration does not generalize as well as TF-only, particularly for peak and maximum rate, due to overcorrection of the protein~C pathway}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S9}{\ignorespaces \textbf  {Level~4: Spearman rank correlations (TF+TM).} Same layout as Supplementary Fig.~\ref {sfig:rankcorr}. Rank correlations under TF+TM are generally weaker than TF-only, consistent with the poorer calibration generalization under this condition.}}{4}{figure.caption.10}\protected@file@percent }
\newlabel{sfig:rankcorr-tm}{{S9}{4}{\textbf {Level~4: Spearman rank correlations (TF+TM).} Same layout as Supplementary Fig.~\ref {sfig:rankcorr}. Rank correlations under TF+TM are generally weaker than TF-only, consistent with the poorer calibration generalization under this condition}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S10}{\ignorespaces \textbf  {Factor~X vs.\ Maximum Clot Firmness (MCF) trajectory.} The characteristic pregnancy-driven shift in the Factor~X--MCF plane is preserved in SA-generated synthetic patients, demonstrating that biologically meaningful multivariate trajectories are captured by the generation pipeline.}}{5}{figure.caption.11}\protected@file@percent }
\newlabel{sfig:x-vs-mcf}{{S10}{5}{\textbf {Factor~X vs.\ Maximum Clot Firmness (MCF) trajectory.} The characteristic pregnancy-driven shift in the Factor~X--MCF plane is preserved in SA-generated synthetic patients, demonstrating that biologically meaningful multivariate trajectories are captured by the generation pipeline}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S11}{\ignorespaces \textbf  {Full longitudinal trajectories.} Individual patient trajectories (all 72 features) across three visits for both real and SA-generated synthetic patients, demonstrating coherent longitudinal patterns.}}{5}{figure.caption.12}\protected@file@percent }
\newlabel{sfig:full-trajectories}{{S11}{5}{\textbf {Full longitudinal trajectories.} Individual patient trajectories (all 72 features) across three visits for both real and SA-generated synthetic patients, demonstrating coherent longitudinal patterns}{figure.caption.12}{}}
